{
  "name": "dsh-session-tool",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "删除会话（含已归档）的 DSH 宿主插件：/sessions-archived 查看、/sessions-delete 删除；默认进回收目录，--purge 永久，--stop 允许删运行中的会话；另提供 session_delete / session_archived_list 两个 agent 工具。",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/immortal-akx/dsh-session-tool.git"
  },
  "homepage": "https://github.com/immortal-akx/dsh-session-tool#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "session"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ]
}
